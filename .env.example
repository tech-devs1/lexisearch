# ==============================================================================
# GHANA LEGAL EVIDENCE INTELLIGENCE SYSTEM (GLEIS) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. FIREBASE CONFIGURATION (Required for Production Identity, DB & Storage)
# Obtain these from Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 2. AUDIO TRANSCRIPTION & SPEECH-TO-TEXT (Whisper API / AssemblyAI / Google STT)
# Used for server-side / direct cloud transcription with word-level timestamps & diarization
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_WHISPER_ENDPOINT=https://api.openai.com/v1/audio/transcriptions

# 3. DEDICATED SEARCH ENGINE (Algolia - Optional if using Built-in Fast Indexer)
# Used for high-volume instant full-text searching across millions of words
VITE_ALGOLIA_APP_ID=your_algolia_app_id
VITE_ALGOLIA_SEARCH_KEY=your_algolia_search_only_api_key
VITE_ALGOLIA_INDEX_NAME=gleis_evidence_index

# 4. GROUNDED LEGAL AI QUESTION ANSWERING & MULTIMODAL TRANSCRIPTION
# Google Gemini API (Single key for Audio/Video Transcription & Evidentiary RAG)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# 5. DEMO & LOCAL DEVELOPMENT MODE
# Set to 'true' to run with built-in realistic mock data, client-side OCR, and local indexed search without cloud credentials
VITE_ENABLE_LOCAL_MODE=true
